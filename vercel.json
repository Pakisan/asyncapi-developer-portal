{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/bindings/:protocol/:version/:file/",
      "destination": "/bindings/:protocol/:version/:file.html",
      "permanent": true
    },
    {
      "source": "/schemes/:path*",
      "destination": "/schemas/:path*",
      "permanent": true
    },
    {
      "source": "/schemas.html",
      "destination": "/schemas/",
      "permanent": true
    },
    {
      "source": "/bindings.html",
      "destination": "/bindings/",
      "permanent": true
    }
  ]
}