---
// Starlight's Markdown wrapper, plus the generated parts of the bindings pages (src/data/binding-pages.ts), the
// security scheme pages (src/data/security-schemes.ts) and the questions of the format guides (src/data/format-faq.ts).
import Default from '@astrojs/starlight/components/MarkdownContent.astro'
import BrokerHub from '../bindings/BrokerHub.astro'
import VersionNote from '../bindings/VersionNote.astro'
import SecurityScheme from '../schemas/SecurityScheme.astro'
import Questions from '../Questions.astro'
import { HUB_ID, hub, versionPage } from '../../data/binding-pages'
import { formatFaq } from '../../data/format-faq'
import { securityPage } from '../../data/security-schemes'

const id = Astro.locals.starlightRoute.entry.id
const brokerHub = HUB_ID.test(id) ? hub(id.split('/')[1]) : undefined
const version = versionPage(id)
const security = securityPage(id)
const faq = formatFaq[id]
---

<Default>
  {version && <VersionNote page={version} />}
  <slot />
  {brokerHub && <BrokerHub hub={brokerHub} />}
  {security && <SecurityScheme page={security} />}
  {faq && <Questions items={faq} />}
</Default>
