---
import Default from '@astrojs/starlight/components/Footer.astro'
import Consent from '../Consent.astro'

const year = new Date().getFullYear()
---

<Default {...Astro.props} />

<div class="site-footer">
  <nav aria-label="Site">
    <a href="/">Home</a>
    <a href="/privacy.html">Privacy</a>
    <a href="#" data-consent-open>Cookie settings</a>
    <a href="https://github.com/Pakisan">GitHub</a>
  </nav>
  <p>
    Copyright &copy; 2024–{year} <a href="https://pavelon.dev">Pavel Bodiachevskii</a> &amp;
    <a href="https://www.asyncapi.com">AsyncAPI community</a>. Released under the
    <a href="https://www.apache.org/licenses/LICENSE-2.0">Apache License 2.0</a>.
  </p>
</div>

<Consent />

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  a {
    color: var(--sl-color-gray-3);
  }
  nav a {
    text-decoration: none;
  }
  a:hover {
    color: var(--sl-color-white);
  }
  p {
    margin: 0;
  }
</style>
