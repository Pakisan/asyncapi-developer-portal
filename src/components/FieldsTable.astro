---
// The fields of a JSON Schema as a table (see src/data/schema-fields.ts): binding and security scheme pages.
import type { Field } from '../data/schema-fields'

interface Props {
  fields: Field[]
}
const { fields } = Astro.props
const depth = (p: string) => p.split('.').length - 1
---

<table class="fields">
  <thead>
    <tr><th>Field</th><th>Type</th><th>Description</th></tr>
  </thead>
  <tbody>
    {
      fields.map((x) => (
        <tr class={depth(x.path) ? 'nested' : undefined}>
          <td style={`padding-left: ${0.75 + depth(x.path)}rem`}>
            <code>{x.path}</code>
            {x.required && <span class="req">required</span>}
          </td>
          <td>
            {x.type}
            {x.values && <div class="values">{x.values.map((val) => <code>{String(val)}</code>)}</div>}
          </td>
          <td>{x.description}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .req {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    font-size: var(--sl-text-xs);
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    white-space: nowrap;
  }
  .nested {
    font-size: var(--sl-text-sm);
  }
  .values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.25rem;
  }
</style>
