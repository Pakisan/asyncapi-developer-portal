---
// Asks once whether Google Analytics may run. Nothing is loaded from Google until the visitor accepts.
// Any element with [data-consent-open] (the footer's "Cookie settings") brings the question back.
import { CONSENT_MAX_AGE_DAYS as consentMaxAgeDays, GA_ID as gaId } from '../data/site';
---

{
	gaId && (
		<div class="consent" data-consent data-ga={gaId} data-max-age={consentMaxAgeDays} role="dialog" aria-label="Analytics cookies" hidden>
			<p>
				May we use Google Analytics cookies to count visits and see which pages and tools people use? Nothing is loaded until you
				say yes. <a href="/privacy.html#cookies">Details</a>
			</p>
			<div class="buttons">
				<button type="button" data-choice="denied">Reject</button>
				<button type="button" data-choice="granted">Accept</button>
			</div>
		</div>
	)
}

<script>
	type Choice = 'granted' | 'denied';
	const KEY = 'pavelon-asyncapi-consent';
	const banner = document.querySelector<HTMLElement>('[data-consent]');

	const read = (): { choice: Choice; at: number } | null => {
		try {
			const saved = JSON.parse(localStorage.getItem(KEY) ?? 'null');
			return saved && (saved.choice === 'granted' || saved.choice === 'denied') ? saved : null;
		} catch {
			return null;
		}
	};

	const loadAnalytics = (id: string) => {
		if (document.getElementById('gtag')) return;
		const w = window as unknown as { dataLayer: unknown[]; gtag: (...args: unknown[]) => void };
		w.dataLayer = w.dataLayer || [];
		w.gtag = function () {
			// gtag expects the arguments object itself, not an array.
			// eslint-disable-next-line prefer-rest-params
			w.dataLayer.push(arguments);
		};
		w.gtag('js', new Date());
		w.gtag('config', id, { allow_google_signals: false, allow_ad_personalization_signals: false });
		const script = document.createElement('script');
		script.id = 'gtag';
		script.async = true;
		script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`;
		document.head.append(script);
	};

	const forgetAnalytics = () => {
		// Remove the cookies Google Analytics set on this site, so "Reject" after "Accept" really withdraws.
		for (const cookie of document.cookie.split(';')) {
			const name = cookie.split('=')[0].trim();
			if (!name.startsWith('_ga')) continue;
			const parts = location.hostname.split('.');
			for (let i = 0; i < parts.length - 1; i++) {
				const domain = parts.slice(i).join('.');
				document.cookie = `${name}=; Max-Age=0; path=/; domain=.${domain}`;
			}
			document.cookie = `${name}=; Max-Age=0; path=/`;
		}
	};

	if (banner) {
		// Starlight renders it inside a contained column, where `position: fixed` would follow the column, not the window.
		document.body.append(banner);
		const id = banner.dataset.ga!;
		const maxAge = Number(banner.dataset.maxAge) * 24 * 60 * 60 * 1000;
		const saved = read();

		if (saved && Date.now() - saved.at < maxAge) {
			if (saved.choice === 'granted') loadAnalytics(id);
		} else {
			banner.hidden = false;
		}

		banner.addEventListener('click', (e) => {
			const button = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-choice]');
			if (!button) return;
			const choice = button.dataset.choice as Choice;
			const previous = read()?.choice;
			try {
				localStorage.setItem(KEY, JSON.stringify({ choice, at: Date.now() }));
			} catch {}
			banner.hidden = true;
			if (choice === 'granted') loadAnalytics(id);
			// A script already running cannot be unloaded: a reload starts the page without it.
			else if (previous === 'granted') {
				forgetAnalytics();
				location.reload();
			}
		});

		document.addEventListener('click', (e) => {
			if (!(e.target as HTMLElement).closest('[data-consent-open]')) return;
			e.preventDefault();
			banner.hidden = false;
			banner.querySelector<HTMLButtonElement>('[data-choice]')?.focus();
		});
	}
</script>

<style>
	/* Works on the landing page and inside Starlight, so it carries its own colours. */
	.consent {
		--c-bg: #ffffff;
		--c-ink: #15171c;
		--c-muted: #5b606b;
		--c-line: #e5e1d8;
		--c-accent: #4f46e5;
		--c-on-accent: #ffffff;
		position: fixed;
		z-index: 100;
		left: 16px;
		right: 16px;
		bottom: 16px;
		max-width: 560px;
		margin: 0 auto;
		padding: 18px 20px;
		display: grid;
		gap: 14px;
		background: var(--c-bg);
		color: var(--c-ink);
		border: 1px solid var(--c-line);
		border-radius: 14px;
		box-shadow: 0 12px 40px -8px rgb(0 0 0 / 0.3);
		font-family: 'Inter Variable', system-ui, sans-serif;
		font-size: 0.92rem;
		line-height: 1.5;
	}
	@media (prefers-color-scheme: dark) {
		:root:not([data-theme='light']) .consent {
			--c-bg: #12151c;
			--c-ink: #eceef2;
			--c-muted: #9aa1ae;
			--c-line: #262b37;
			--c-accent: #818cf8;
			--c-on-accent: #0b0b1a;
		}
	}
	:root[data-theme='dark'] .consent {
		--c-bg: #12151c;
		--c-ink: #eceef2;
		--c-muted: #9aa1ae;
		--c-line: #262b37;
		--c-accent: #818cf8;
		--c-on-accent: #0b0b1a;
	}
	.consent[hidden] {
		display: none;
	}
	p {
		margin: 0;
		color: var(--c-muted);
	}
	a {
		color: var(--c-accent);
	}
	.buttons {
		display: flex;
		gap: 10px;
		justify-content: flex-end;
	}
	/* Equal weight: neither answer is easier to reach than the other. */
	button {
		flex: 1;
		max-width: 160px;
		padding: 9px 16px;
		border-radius: 999px;
		border: 1px solid var(--c-accent);
		background: var(--c-bg);
		color: var(--c-ink);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	button:hover {
		background: var(--c-accent);
		color: var(--c-on-accent);
	}
	button:focus-visible {
		outline: 2px solid var(--c-accent);
		outline-offset: 2px;
	}
</style>
