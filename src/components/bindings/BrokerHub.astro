---
// Generated sections at the end of a broker page: version history, the latest fields, schema URLs and FAQ.
import { changeSummary, type Hub, objectLabel } from '../../data/binding-pages'
import { BINDING_OBJECTS, registryUrl } from '../../data/binding-schemas'

interface Props {
  hub: Hub
}
const { hub: h } = Astro.props

// `code` spans in change lines, written as Markdown in the model
const inline = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/`([^`]+)`/g, '<code>$1</code>')
const depth = (p: string) => p.split('.').length - 1
---

<h2 id="versions">Versions and changes</h2>
{
  h.deprecated && (
    <p>
      <strong>Deprecated</strong> in favour of the <a href={h.deprecated.href}>{h.deprecated.by}</a>.
    </p>
  )
}
<p>Generated from the binding JSON Schemas: every field each version added or removed.</p>
<table class="versions">
  <thead>
    <tr><th>Version</th><th>What changed</th><th>Pages</th></tr>
  </thead>
  <tbody>
    {
      h.history.map((v, i) => (
        <tr>
          <td>
            <strong>{v.version}</strong>
            {v.version === h.latest && <span class="latest">latest</span>}
          </td>
          <td>
            {changeSummary(v, i === h.history.length - 1).map((line) => (
              <p set:html={inline(line)} />
            ))}
          </td>
          <td>{v.pages.map((p, j) => [j > 0 && ', ', <a href={p.href}>{p.object}</a>])}</td>
        </tr>
      ))
    }
  </tbody>
</table>

{
  h.fields.length > 0 && (
    <>
      <h2 id="fields">Fields in version {h.latest}</h2>
      {h.fields.map((f) => (
        <>
          <h3 id={`fields-${f.object}`}>{objectLabel(f.object)}</h3>
          <table class="fields">
            <thead>
              <tr><th>Field</th><th>Type</th><th>Description</th></tr>
            </thead>
            <tbody>
              {f.fields.map((x) => (
                <tr class={depth(x.path) ? 'nested' : undefined}>
                  <td style={`padding-left: ${0.75 + depth(x.path)}rem`}>
                    <code>{x.path}</code>
                    {x.required && <span class="req">required</span>}
                  </td>
                  <td>
                    {x.type}
                    {x.values && <div class="values">{x.values.map((val) => <code>{String(val)}</code>)}</div>}
                  </td>
                  <td>{x.description}</td>
                </tr>
              ))}
            </tbody>
          </table>
          {f.href && (
            <p>
              <a href={f.href}>{objectLabel(f.object)} {h.latest}: examples and details</a>
            </p>
          )}
        </>
      ))}
    </>
  )
}

<h2 id="json-schema">Validate with JSON Schema</h2>
<p>
  Point your editor, CI or AI agent at these schemas to validate the {h.name} bindings of version {h.latest}. They come from the{' '}
  <a href="/schemas/registry.html">AsyncAPI JSON Schema registry</a>.
</p>
<ul class="schemas">
  {
    BINDING_OBJECTS.map((o) => (
      <li>
        {objectLabel(o)}: <a href={registryUrl(h.broker, h.latest, o)}><code>{registryUrl(h.broker, h.latest, o)}</code></a>
      </li>
    ))
  }
</ul>

{
  h.faq.length > 0 && (
    <>
      <h2 id="questions">Questions</h2>
      {h.faq.map((q) => (
        <details class="qa">
          <summary>{q.q}</summary>
          <p set:html={q.a} />
        </details>
      ))}
    </>
  )
}

<style>
  .versions td p {
    margin: 0;
  }
  .versions td p + p {
    margin-top: 0.4rem;
  }
  .latest,
  .req {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    font-size: var(--sl-text-xs);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    white-space: nowrap;
  }
  .req {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
  }
  .fields .nested {
    font-size: var(--sl-text-sm);
  }
  .values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.25rem;
  }
  .schemas code {
    word-break: break-all;
  }
  .qa {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
  }
  .qa + .qa {
    margin-top: 0.5rem;
  }
  .qa summary {
    cursor: pointer;
    font-weight: 600;
  }
  .qa p {
    margin-top: 0.5rem;
  }
</style>
