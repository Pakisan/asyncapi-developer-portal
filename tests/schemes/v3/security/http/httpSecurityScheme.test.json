{
  "target": "https://asyncapi.pavelon.dev/schemas/v3/security/http/httpSecuritySchema.json",
  "$comment": "API Key HTTP Security Schema test cases",
  "tests": [
    {
      "description": "The empty object is not valid",
      "valid": false,
      "data": {}
    },
    {
      "description": "Is valid when is Bearer HTTP Security Schema",
      "valid": true,
      "data": {
        "type" : "http",
        "description" : "http",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    },
    {
      "description": "Is valid when is Non Bearer HTTP Security Schema",
      "valid": true,
      "data": {
        "type" : "http",
        "description" : "http",
        "scheme" : "basic"
      }
    },
    {
      "description": "Is valid when is API Key HTTP Security Schema",
      "valid": true,
      "data": {
        "description": "http",
        "type": "httpApiKey",
        "name": "api_key",
        "in": "query"
      }
    }
  ]
}