{
  "target": "https://asyncapi.pavelon.dev/schemas/v3/security/userPassword.json",
  "$comment": "User Password Security Schema test cases",
  "tests": [
    {
      "description": "The empty object is not valid",
      "valid": false,
      "data": {}
    },
    {
      "description": "Is valid when `type` is userPassword",
      "valid": true,
      "data": {
        "type": "userPassword",
        "description": "userPassword"
      }
    },
    {
      "description": "Is not valid when `type` is not userPassword",
      "valid": false,
      "data": {
        "type": "user-password",
        "description": "userPassword"
      }
    },
    {
      "description": "Is valid when is correctly extended",
      "valid": true,
      "data": {
        "type": "userPassword",
        "description": "userPassword",
        "x-number" : 0,
        "x-string" : "",
        "x-object" : {
          "property" : { }
        }
      }
    },
    {
      "description": "Is not valid when is wrongly extended",
      "valid": false,
      "data": {
        "type": "userPassword",
        "description": "userPassword",
        "ext-number": 1
      }
    }
  ]
}