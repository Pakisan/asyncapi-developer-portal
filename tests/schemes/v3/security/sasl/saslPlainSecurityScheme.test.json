{
  "target": "https://asyncapi.pavelon.dev/schemas/v3/security/sasl/saslPlainSecuritySchema.json",
  "$comment": "Asymmetric Encryption Security Schema test cases",
  "tests": [
    {
      "description": "The empty object is not valid",
      "valid": false,
      "data": {}
    },
    {
      "description": "Is valid when `type` is plain",
      "valid": true,
      "data": {
        "type": "plain",
        "description": "plain"
      }
    },
    {
      "description": "Is not valid when `type` is not plain",
      "valid": false,
      "data": {
        "type": "plain-type",
        "description": "plain"
      }
    },
    {
      "description": "Is valid when is correctly extended",
      "valid": true,
      "data": {
        "type": "plain",
        "description": "plain",
        "x-number" : 0,
        "x-string" : "",
        "x-object" : {
          "property" : { }
        }
      }
    },
    {
      "description": "Is not valid when is wrongly extended",
      "valid": false,
      "data": {
        "type": "plain",
        "description": "plain",
        "ext-number": 1
      }
    }
  ]
}