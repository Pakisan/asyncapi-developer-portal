{
  "target": "https://asyncapi.pavelon.dev/schemes/v3/security/oauth2/flows/authorizationCodeOAuthFlow.json",
  "$comment": "Password OAuth Flow test cases",
  "tests": [
    {
      "description": "The empty object is not valid",
      "valid": false,
      "data": {}
    },
    {
      "description": "Is valid",
      "valid": true,
      "data": {
        "authorizationUrl": "https://example.com/api/oauth/dialog",
        "tokenUrl": "https://example.com/api/oauth/token",
        "refreshUrl": "https://example.com/api/oauth/refresh",
        "availableScopes": {
          "write:pets": "modify pets in your account",
          "read:pets": "read your pets"
        }
      }
    },
    {
      "description": "Is valid when is correctly extended",
      "valid": true,
      "data": {
        "authorizationUrl": "https://example.com/api/oauth/dialog",
        "tokenUrl": "https://example.com/api/oauth/token",
        "refreshUrl": "https://example.com/api/oauth/refresh",
        "availableScopes": {
          "write:pets": "modify pets in your account",
          "read:pets": "read your pets"
        },
        "x-number" : 0,
        "x-string" : "",
        "x-object" : {
          "property" : { }
        }
      }
    },
    {
      "description": "Is not valid when is wrongly extended",
      "valid": false,
      "data": {
        "authorizationUrl": "https://example.com/api/oauth/dialog",
        "tokenUrl": "https://example.com/api/oauth/token",
        "refreshUrl": "https://example.com/api/oauth/refresh",
        "availableScopes": {
          "write:pets": "modify pets in your account",
          "read:pets": "read your pets"
        },
        "ext-number": 1
      }
    }
  ]
}