{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/apache-kafka/0.1.0/operation.json",
  "title": "Kafka operation message bindings object",
  "description": "This object contains information about the operation representation in Kafka.",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  },
  "properties": {
    "groupId": {
      "$ref": "https://asyncapi.pavelon.dev/schemas/schema.json",
      "description": "Id of the consumer group."
    },
    "clientId": {
      "$ref": "https://asyncapi.pavelon.dev/schemas/schema.json",
      "description": "Id of the consumer inside a consumer group."
    },
    "bindingVersion": {
      "type": "string",
      "enum": [
        "0.1.0"
      ],
      "description": "The version of this binding. If omitted, 'latest' MUST be assumed."
    }

  },
  "examples": [
    {
      "groupId": {
        "type": "string",
        "enum": [
          "myGroupId"
        ]
      },
      "clientId": {
        "type": "string",
        "enum": [
          "myClientId"
        ]
      },
      "bindingVersion": "0.1.0"
    }
  ]
}
