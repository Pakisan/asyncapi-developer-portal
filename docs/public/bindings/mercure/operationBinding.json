{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/bindings/mercure/operationBinding.json",
  "title": "Mercure - Operation Binding",
  "description": "Describes protocol-specific definitions for a operation",
  "type": "object",
  "examples": [
    {},
    {
      "bindingVersion": "latest"
    },
    {
      "bindingVersion": "0.1.0"
    }
  ],
  "allOf": [
    {
      "if": {
        "required": ["bindingVersion"],
        "properties": { "bindingVersion": { "const": "0.1.0" } }
      },
      "then": { "$ref": "https://asyncapi.pavelon.dev/bindings/mercure/0.1.0/operation.json" }
    },
    {
      "description": "If bindingVersion is omitted, than use latest JSON Schema",
      "if": {
        "not": {
          "required": ["bindingVersion"],
          "properties": {
            "bindingVersion": { "const": "0.1.0" }
          }
        }
      },
      "then": { "$ref": "https://asyncapi.pavelon.dev/bindings/mercure/0.1.0/operation.json" }
    }
  ]
}
