{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/schemas/v3/operations/operationTraits.json",
  "title": "AsyncAPI v3 - Channel Message Traits",
  "description": "Collection of Channel Message Traits. Traits MUST be merged using traits merge mechanism. The resulting object MUST be a valid Message Object",
  "type": "array",
  "items": {
    "if": {
      "required": [ "$ref" ],
      "properties": {
        "$ref": true
      }
    },
    "then": {
      "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
    },
    "else": {
      "$id": "https://asyncapi.pavelon.dev/schemas/v3/operations/operationTrait.json"
    }
  }
}
