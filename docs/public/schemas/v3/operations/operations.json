{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/schemas/v3/operations/operations.json",
  "type": "object",
  "title": "AsyncAPI v3 - Operations Map",
  "description": "A key-value map where key is operation ID and value is operation representation",
  "additionalProperties": {
    "if": {
      "required": ["$ref"],
      "properties": {
        "$ref": true
      }
    },
    "then": {
      "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
    },
    "else": {
      "$ref": "https://asyncapi.pavelon.dev/schemas/v3/operations/operation.json"
    }
  }
}
