{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/schemas/v3/servers/server.json",
  "description": "An object representing a message broker, a server or any other kind of computer program capable of sending and/or receiving data.",
  "examples": [
    {
      "x-microcks-enabled": true,
      "title": "Secured MQTT broker",
      "summary": "MQTT 5.0 broker",
      "description": "Staging secured MQTT 5.0 broker",
      "host": "{username}.gigantic-server.com:{port}/{basePath}",
      "protocol": "secure-mqtt",
      "protocolVersion": "5",
      "pathname": "/messages",
      "variables": {
        "username": {
          "description": "This value is assigned by the service provider, in this example `gigantic-server.com`",
          "default": "production"
        },
        "port": {
          "enum": [ "8883", "14567" ],
          "default": "8883"
        },
        "basePath": {
          "$ref": "#/components/serverVariables/basePath"
        }
      },
      "security": [
        {
          "type": "usernamePassword",
          "description": "Sent inside the initial CONNECT message"
        },
        {
          "$ref": "#/components/security/x.509"
        }
      ],
      "tags": [
        {
          "name": "env:staging",
          "description": "This environment is a replica of the production environment"
        },
        {
          "$ref": "#/tags/secured"
        }
      ],
      "externalDocs": {
        "description": "Reade step by step guide to integrate with Gigantic server",
        "url": "https://gigantic-server.com/docs/integrations"
      }
    }
  ],
  "type": "object",
  "required": [ "host", "protocol" ],
  "properties": {
    "host": {
      "description": "The server host name. It MAY include the port. This field supports Server Variables. Variable substitutions will be made when a variable is named in {braces}",
      "type": "string"
    },
    "pathname": {
      "description": "The path to a resource in the host. This field supports Server Variables. Variable substitutions will be made when a variable is named in {braces}",
      "type": "string"
    },
    "title": {
      "description": "A human-friendly title for the server",
      "type": "string"
    },
    "summary": {
      "description": "A brief summary of the server",
      "type": "string"
    },
    "description": {
      "description": "A longer description of the server. CommonMark is allowed",
      "type": "string"
    },
    "protocol": {
      "description": "The protocol this server supports for connection",
      "type": "string"
    },
    "protocolVersion": {
      "description": "An optional string describing the server. CommonMark syntax MAY be used for rich text representation",
      "type": "string"
    },
    "variables": {
      "if": {
        "required": [ "$ref" ]
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
      },
      "else": {
        "$ref": "https://asyncapi.pavelon.dev/schemas/v3/servers/serverVariable.json"
      }
    },
    "security": {
      "$ref": "https://asyncapi.pavelon.dev/schemas/v3/securityRequirements.json"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "if": {
          "required": [ "$ref" ]
        },
        "then": {
          "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
        },
        "else": {
          "$ref": "https://asyncapi.pavelon.dev/schemas/v3/tag.json"
        }
      }
    },
    "externalDocs": {
      "if": {
        "required": [ "$ref" ]
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
      },
      "else": {
        "$ref": "https://asyncapi.pavelon.dev/schemas/v3/externalDocs.json"
      }
    },
    "bindings": {
      "if": {
        "required": [ "$ref" ]
      },
      "then": {
        "$ref": "https://asyncapi.pavelon.dev/schemas/reference.json"
      },
      "else": {
        "$ref": "https://asyncapi.pavelon.dev/schemas/v3/servers/serverBindings.json"
      }
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  },
  "additionalProperties": false
}
