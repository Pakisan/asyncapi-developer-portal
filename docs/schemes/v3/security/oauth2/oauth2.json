{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asyncapi.pavelon.dev/schemes/v3/security/oauth2/oauth2.json",
  "description": "Allows configuration of the supported OAuth Flows.",
  "type": "object",
  "required": [ "type", "flows" ],
  "properties": {
    "description": {
      "description": "A short description for security scheme.",
      "type": "string"
    },
    "type": {
      "description": "The type of the security scheme.",
      "type": "string",
      "enum": [ "oauth2" ]
    },
    "flows": {
      "type": "object",
      "properties": {
        "authorizationCode": {
          "$ref": "https://asyncapi.pavelon.dev/schemes/v3/security/oauth2/flows/authorizationCodeOAuthFlow.json"
        },
        "clientCredentials": {
          "$ref": "https://asyncapi.pavelon.dev/schemes/v3/security/oauth2/flows/clientCredentialsOAuthFlow.json"
        },
        "implicit": {
          "$ref": "https://asyncapi.pavelon.dev/schemes/v3/security/oauth2/flows/implicitOAuthFlow.json"
        },
        "password": {
          "$ref": "https://asyncapi.pavelon.dev/schemes/v3/security/oauth2/flows/passwordOAuthFlow.json"
        }
      },
      "additionalProperties": false
    },
    "scopes": {
      "description": "List of the needed scope names.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "patternProperties": {
    "^x-[\\w\\d\\.\\x2d_]+$": true
  },
  "additionalProperties": false
}
